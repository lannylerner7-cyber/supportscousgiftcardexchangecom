# ScousGiftCardExchange — copy to .env on your VPS and fill in the real values.
# Never commit the real .env.

# ---------------------------------------------------------------- app
PORT=3000
# Public address of the site; used in the links inside emails.
APP_URL=REPLACE_WITH_YOUR_APP_URL
# Signs the sign-in cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=REPLACE_WITH_YOUR_SESSION_SECRET

# ------------------------------------------- your Cloudflare database (D1)
# The app reaches your own D1 database and R2 storage through Cloudflare's API.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_CLOUDFLARE_ACCOUNT_ID
D1_DATABASE_ID=REPLACE_WITH_YOUR_D1_DATABASE_ID
# Bucket that holds card photos and chat images (private).
R2_BUCKET=REPLACE_WITH_YOUR_R2_BUCKET
# Credentials used to reach Cloudflare. Server-only — keep them secret.
LOVABLE_API_KEY=
CLOUDFLARE_API_KEY=

# ---------------------------------------------------------------- mail
# Cloudflare Email Service SMTP
SMTP_HOST=REPLACE_WITH_YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_YOUR_SMTP_USER
SMTP_PASS=REPLACE_WITH_YOUR_SMTP_PASS

# Sender identity shown in the inbox
APP_EMAIL_FROM=REPLACE_WITH_YOUR_APP_EMAIL_FROM
APP_EMAIL_FROM_NAME=REPLACE_WITH_YOUR_APP_EMAIL_FROM_NAME
APP_EMAIL_REPLY_TO=REPLACE_WITH_YOUR_APP_EMAIL_REPLY_TO

# -------------------------------------------------------------- extras
# The email address that is always treated as an owner of the admin panel.
ADMIN_EMAIL=
