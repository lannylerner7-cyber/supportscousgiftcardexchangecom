# ScousGiftCardExchange — copy to .env on your VPS and fill in the real values.
# Never commit the real .env.

# ---------------------------------------------------------------- app
PORT=3000
# Public address of the site; used in the links inside emails.
APP_URL=https://example.com
# Signs the sign-in cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=replace-me

# ------------------------------------------- your Cloudflare database (D1)
# The app reaches your own D1 database and R2 storage through Cloudflare's API.
CLOUDFLARE_ACCOUNT_ID=replace-me
D1_DATABASE_ID=replace-me
# Bucket that holds card photos and chat images (private).
R2_BUCKET=your-private-bucket
# Credentials used to reach Cloudflare. Server-only — keep them secret.
LOVABLE_API_KEY=replace-me
CLOUDFLARE_API_KEY=replace-me

# ---------------------------------------------------------------- mail
# Cloudflare Email Service SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me

# Sender identity shown in the inbox
APP_EMAIL_FROM=noreply@example.com
APP_EMAIL_FROM_NAME=ScousExchange
APP_EMAIL_REPLY_TO=support@example.com

# -------------------------------------------------------------- extras
# The email address that is always treated as an owner of the admin panel.
ADMIN_EMAIL=owner@example.com
